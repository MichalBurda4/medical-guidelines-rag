# Copy once:  cp .env.example .env      (from the repo root)
# This single file is used by Docker:
#   - compose injects it into `api` and `ollama-pull` via `env_file`
#   - ollama-pull reads EMBEDDING_MODEL at container startup
#   - compose also reads it for `${...}` interpolation (image tags below)
# No `docker compose --env-file` flag is needed.
# The API never parses this file itself — it reads the process environment, which
# compose populates. A host run (`npm run dev`) gets nothing from it: export the
# variables in your shell or use `uv run --env-file .env ...` from packages/server.
# .env is gitignored — never commit real keys.

# ── LLM (required: the API refuses to start without one) ──────────────────────
# Enables the OpenAI provider. Model override: OPENAI_MODEL (default gpt-4o-mini).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Enables the DeepSeek provider. Model override: DEEPSEEK_MODEL.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ── Local embeddings (Ollama) ─────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Must match the model pulled by the `ollama-pull` compose service.
EMBEDDING_MODEL=bge-m3
# Models trained with task prefixes (e.g. nomic-embed-text) need both of these:
#   EMBEDDING_PASSAGE_PREFIX=search_document:
#   EMBEDDING_QUERY_PREFIX=search_query:

# ── Vector store (Chroma) ─────────────────────────────────────────────────────
CHROMA_URL=http://127.0.0.1:8000
# The collection name is derived from EMBEDDING_MODEL by default, so a model
# switch never reuses vectors of a different dimension. Override only if needed.
# CHROMA_COLLECTION=chunks_bge_m3

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Similarity (1 - cosine distance) below which a chunk is not used at all.
# Measured on sample-guidelines/hay-fever.txt with bge-m3:
#   on-topic questions  0.537 – 0.697
#   off-topic questions 0.242 – 0.442
# 0.48 sits between the two. Re-calibrate when you add real guidelines: raise it
# if off-topic questions come back with sources, lower it if valid ones are refused.
RETRIEVAL_MIN_SCORE=0.48
RETRIEVAL_TOP_K=5

# How many times the agent may rephrase the question after a literal search found
# nothing above RETRIEVAL_MIN_SCORE. Rewriting fixes vocabulary mismatch (a business
# question phrased casually can sit just below the threshold) without lowering it.
# 0 disables rewriting and restores single-shot retrieval.
RETRIEVAL_MAX_REWRITES=2

# ── Docker image tags (pin these for reproducible builds) ─────────────────────
# Must match the chromadb-client version from `uv pip list` (currently 1.5.9).
# Compose resolves ${...} before any container starts and reads this root `.env`
# on its own, so uncommenting these is enough — no flag, no shell export.
# A shell value still wins, e.g. OLLAMA_VERSION=latest npm run docker:up
# CHROMA_VERSION=1.5.9
# OLLAMA_VERSION=latest
