# 1. From this folder, copy this file once:
#      cp .env.example .env
#    .env is gitignored. Put real keys there, not in this file.
# 2. Paste a key after the "=". Leave a key empty to keep that model disabled.
# 3. Restart `npm run dev` after you change .env. A running server will not reload it.

# Server port
PORT=3001

# Enables "Answer model → OpenAI" in the sidebar. Default model: gpt-4o-mini.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Enables "Answer model → DeepSeek" in the sidebar. Default model: deepseek-chat.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
