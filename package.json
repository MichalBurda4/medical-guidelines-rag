{
  "name": "medirag-chatbot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev -w @medirag/server\" \"npm run dev -w @medirag/client\"",
    "dev:api": "npm run dev -w @medirag/server",
    "dev:web": "npm run dev -w @medirag/client",
    "start:api": "npm run start -w @medirag/server",
    "typecheck": "tsc -b",
    "build": "tsc -b && npm run build -w @medirag/client",
    "preview": "npm run preview -w @medirag/client",
    "lint": "oxlint",
    "test:hay-fever": "node scripts/test-hay-fever.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
